---
/**
 * Home Page
 * 
 * Case-study-first portfolio homepage that immediately showcases real impact and outcomes
 * rather than generic taglines. Features a hero section with featured project snapshots,
 * testimonials, and clear calls-to-action.
 * 
 * Design Philosophy:
 * - Lead with tangible results and case studies
 * - Document decision-making process transparently
 * - Demonstrate value through real project outcomes
 * - Provide multiple entry points (projects)
 * 
 * Sections:
 * 1. Hero - Value statement with featured case study snapshots
 * 2. Introduction - Brief personal introduction
 * 3. Experience - Concise professional background
 * 4. Thinking - Problems and topics of interest
 * 5. CTA - Call-to-action for work opportunities
 * 
 * Features:
 * - Featured projects showcase (top 2-3)
 * - Curated project snapshots
 * - Structured data for SEO (WebSite and Person)
 * - Responsive grid layout
 * - Multiple CTAs for different user intents
 * 
 * Route: /
 * 
 * @page
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

/**
 * Queries and filters featured projects for hero section
 * 
 * Retrieves all projects, filters for featured ones, sorts by custom order
 * (if specified), and limits to top 2 for the hero snapshots.
 */
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

/**
 * Case snapshots for hero display
 * 
 * Takes up to 3 featured projects to showcase in the hero section,
 * providing immediate evidence of impact and outcomes.
 */
const caseSnapshots = featuredProjects.slice(0, 3);

---

<BaseLayout>
  <SEO 
    slot="head"
    title={siteConfig.title}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  <!-- Structured Data for Homepage -->
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <p class="eyebrow">BACKEND SOFTWARE ENGINEER</p>
          <h1 class="hero-title">
            I build backend systems that stay reliable beyond the happy path.
          </h1>
          <p class="hero-sub">
            Backend Software Engineer focused on Python, FastAPI, distributed systems and applied AI — from API design and event-driven processing to deployment and reliability.
          </p>
          <p class="hero-technologies">
            Python · FastAPI · PostgreSQL · Redis · Docker · Distributed Systems
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn-primary">View Case Studies</a>
            {siteConfig.social.github && (
              <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
            )}
          </div>
        </div>

        <div class="hero-right">
          <h2 class="section-label">Featured Work</h2>
          <div class="case-snapshots">
            {caseSnapshots.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class="case-label">Case Study · {project.data.role}</span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{project.data.outcomeSummary}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="introduction" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p>
        I'm {siteConfig.author.name}, a Backend Software Engineer and Computer Science student focused on distributed systems, reliability and applied AI.
      </p>
      <p>
        I work primarily with Python, FastAPI, PostgreSQL, Redis and Docker, building backend services and integrating systems that need to process data reliably across different components.
      </p>
      <p>
        My current professional work combines backend engineering, distributed processing and real-time computer vision.
      </p>
    </section>

    <section class="experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="experience-list">
        <article class="experience-item experience-item--primary">
          <div class="experience-header">
            <div>
              <h3>STRANS - Superintendência Municipal de Transportes e Trânsito</h3>
              <p class="experience-role">IT Intern — Software Engineering &amp; Computer Vision</p>
            </div>
            <p class="experience-period">April 2026 — Present</p>
          </div>
          <p class="experience-summary">
            I contribute to an intelligent traffic monitoring platform by building Python and FastAPI services, PostgreSQL data flows and Redis-based event processing. My work also covers reliability mechanisms, infrastructure and the integration of real-time computer vision pipelines using YOLO, OCR and RTSP.
          </p>
          <p class="experience-stack">Python · FastAPI · PostgreSQL · Redis · Docker · MinIO/S3 · Pytest · YOLO · OCR · RTSP</p>
        </article>

        <article class="experience-item">
          <div class="experience-header">
            <div>
              <h3>Digzen Automações B2B</h3>
              <p class="experience-role">Chatbot Developer</p>
            </div>
            <p class="experience-period">October 2025 — December 2025</p>
          </div>
          <p class="experience-summary">
            I built an AI-powered conversational workflow for lead qualification, integrating the OpenAI API, n8n and external services to automate operational steps such as meeting scheduling.
          </p>
          <p class="experience-stack">OpenAI API · n8n · API Integration · LLMs · Automation</p>
        </article>
      </div>
    </section>

    <section class="thinking">
      <h2>Problems I like to solve</h2>
      <p class="thinking-list">
        Distributed backend systems · Event-driven processing · Reliability and failure recovery · API and service integration · Data persistence and consistency · Applied AI integration · Systems that evolve without unnecessary coupling
      </p>
    </section>

    <section class="cta">
      <h2>Let's build reliable systems</h2>
      <p>
        I'm open to backend software engineering opportunities involving distributed systems, reliability and applied AI.
      </p>
      <div class="cta-buttons">
        <a href="/projects" class="btn-primary">View Case Studies</a>
        <a href="/contact" class="btn-secondary">Get in Touch</a>
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 4rem 0 5rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 4rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .hero-left {
      padding-right: 2rem;
    }

    .eyebrow,
    .section-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
    }

    .hero-title {
      font-size: 2.25rem;
      line-height: 1.3;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
      color: var(--color-text);
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .hero-technologies {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--color-text-secondary);
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .case-snapshot {
      display: block;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .case-snapshot:hover {
      border-color: var(--color-text-muted);
      background: var(--color-bg-elevated);
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .introduction {
      max-width: 600px;
      margin-bottom: 5rem;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .introduction h2,
    .experience h2,
    .thinking h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
    }

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-of-type {
      color: var(--color-text);
    }

    .experience,
    .thinking {
      margin-bottom: 5rem;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .experience-item {
      padding: 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }

    .experience-item--primary {
      border-left: 3px solid var(--color-accent);
    }

    .experience-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    .experience-header h3 {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 0.375rem;
    }

    .experience-role,
    .experience-period,
    .experience-stack {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin: 0;
    }

    .experience-period {
      flex-shrink: 0;
      text-align: right;
    }

    .experience-summary {
      max-width: 760px;
      font-size: 0.9375rem;
      line-height: 1.65;
      margin-bottom: 1rem;
    }

    .experience-stack {
      line-height: 1.6;
    }

    .thinking-list {
      font-size: 1.0625rem;
      line-height: 1.9;
      color: var(--color-text-secondary);
      max-width: 680px;
    }

    .cta {
      padding: 3rem 0;
      border-top: 1px solid var(--color-border);
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 500px;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.5rem 0 3rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-left {
        padding-right: 0;
      }

      .hero-title {
        font-size: 1.75rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        text-align: center;
        width: 100%;
      }

      .case-snapshot {
        padding: 1rem 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .experience-item {
        padding: 1.25rem;
      }

      .experience-header {
        flex-direction: column;
        gap: 0.5rem;
      }

      .experience-period {
        text-align: left;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn-primary,
      .cta-buttons .btn-secondary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>

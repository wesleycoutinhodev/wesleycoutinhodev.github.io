---
/**
 * Home Page
 * 
 * Case-study-first portfolio homepage that immediately showcases real impact and outcomes
 * rather than generic taglines. Features a hero section with featured project snapshots,
 * testimonials, and clear calls-to-action.
 * 
 * Design Philosophy:
 * - Lead with tangible results and case studies
 * - Document decision-making process transparently
 * - Demonstrate value through real project outcomes
 * - Provide multiple entry points (projects)
 * 
 * Sections:
 * 1. Hero - Value statement with featured case study snapshots
 * 2. Introduction - Brief personal introduction
 * 3. Focus - Areas of work
 * 4. Principles - How I work
 * 5. Experience - Professional background
 * 6. Skills - Grouped technical skills
 * 7. Education & Certifications
 * 8. CTA - Call-to-action for work opportunities
 * 
 * Features:
 * - Featured projects showcase (top 2-3)
 * - Curated project snapshots
 * - Structured data for SEO (WebSite and Person)
 * - Responsive grid layout
 * - Multiple CTAs for different user intents
 * 
 * Route: /
 * 
 * @page
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

/**
 * Queries and filters featured projects for hero section
 * 
 * Retrieves all projects, filters for featured ones, sorts by custom order
 * (if specified), and limits to top 2 for the hero snapshots.
 */
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

/**
 * Case snapshots for hero display
 * 
 * Takes up to 3 featured projects to showcase in the hero section,
 * providing immediate evidence of impact and outcomes.
 */
const caseSnapshots = featuredProjects.slice(0, 3);

---

<BaseLayout>
  <SEO 
    slot="head"
    title={siteConfig.title}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  <!-- Structured Data for Homepage -->
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <p class="eyebrow">AI ENGINEER · SOFTWARE ENGINEERING</p>
          <h1 class="hero-title">
            I build AI systems you can measure, test and trust.
          </h1>
          <p class="hero-sub">
            Software engineer specializing in LLM applications, retrieval and machine learning. I work across the whole path, from data and models to the APIs, pipelines and tests that put them in front of real users.
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn-primary">View Projects</a>
            <a href="/contact" class="btn-secondary">Get in Touch</a>
          </div>
        </div>

        <div class="hero-right">
          <h2 class="section-label">Featured Work</h2>
          <div class="case-snapshots">
            {caseSnapshots.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class="case-label">Case Study · {project.data.year}</span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{project.data.outcomeSummary}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="introduction" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p>
        I'm {siteConfig.author.name}, a Computer Science student at UFPI and a software engineer focused on AI systems.
      </p>
      <p>
        Most of what makes an AI system useful happens around the model: how data is prepared, how context is retrieved, how outputs are checked and how the service behaves when something fails. That's the work I enjoy most.
      </p>
      <p>
        Today I build backend services and machine learning pipelines for a traffic monitoring platform, and research retrieval-augmented generation over institutional documents.
      </p>
    </section>

    <section class="focus" aria-labelledby="focus-heading">
      <h2 id="focus-heading">What I work on</h2>
      <div class="focus-grid">
        <article class="focus-item">
          <h3>LLM applications &amp; RAG</h3>
          <p>Retrieval, grounding and agent workflows, plus evaluating whether answers are actually supported by their sources.</p>
        </article>
        <article class="focus-item">
          <h3>Machine learning</h3>
          <p>Dataset curation, training and evaluation, with care for clean splits, data leakage and honest benchmarks.</p>
        </article>
        <article class="focus-item">
          <h3>Engineering for AI systems</h3>
          <p>APIs, event-driven pipelines, idempotency, retries and contract tests: everything a model needs to run reliably.</p>
        </article>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-heading">
      <h2 id="principles-heading">How I work</h2>
      <dl class="principles-list">
        <div>
          <dt>Measure before claiming</dt>
          <dd>Changes are judged by evaluation, and results are reported together with their limits.</dd>
        </div>
        <div>
          <dt>Ground outputs in sources</dt>
          <dd>Answers should point to evidence. When the evidence isn't there, the system should say so.</dd>
        </div>
        <div>
          <dt>Design for the failure path</dt>
          <dd>Retries, idempotency and fallbacks are part of the design, not an afterthought.</dd>
        </div>
      </dl>
    </section>

    <section class="experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="experience-list">
        <article class="experience-item experience-item--primary">
          <div class="experience-header">
            <div>
              <h3>STRANS - Superintendência Municipal de Transportes e Trânsito</h3>
              <p class="experience-role">IT Intern — Software Engineering &amp; Computer Vision</p>
            </div>
            <p class="experience-period">April 2026 — Present</p>
          </div>
          <ul class="experience-points">
            <li>Build backend services and REST APIs for a distributed traffic monitoring platform, connecting AI workloads running at the edge to backend services through event-driven communication.</li>
            <li>Design asynchronous processing and reliability mechanisms (idempotency, retries, failure recovery, backpressure and versioned contracts) covered by unit, integration and contract tests.</li>
            <li>Develop machine learning pipelines end to end: dataset preparation, training, benchmarking, inference and model evaluation.</li>
            <li>Helped separate evidence storage from event transport using S3-compatible object storage and lightweight references, reducing message payloads and coupling between services.</li>
          </ul>
          <p class="experience-stack">Python · FastAPI · PostgreSQL · Redis Streams · Docker · MinIO/S3 · Pytest · Machine Learning</p>
        </article>

        <article class="experience-item">
          <div class="experience-header">
            <div>
              <h3>Digzen Automações B2B</h3>
              <p class="experience-role">Chatbot Developer</p>
            </div>
            <p class="experience-period">October 2025 — December 2025</p>
          </div>
          <ul class="experience-points">
            <li>Built an LLM-powered conversational agent for lead qualification using the OpenAI API, connected to automated sales workflows.</li>
            <li>Orchestrated n8n workflows and external APIs to automate commercial steps such as meeting scheduling.</li>
          </ul>
          <p class="experience-stack">OpenAI API · LLMs · n8n · API Integration · Automation</p>
        </article>
      </div>
    </section>

    <section class="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <dl class="skills-list">
        <div>
          <dt>AI &amp; LLMs</dt>
          <dd>LLMs · RAG · AI agents · LangGraph · LangChain · OpenAI API · Embeddings · FAISS · Chroma · Hugging Face</dd>
        </div>
        <div>
          <dt>Machine learning</dt>
          <dd>Dataset curation · Training · Inference · Model evaluation · Transformers · scikit-learn · pandas</dd>
        </div>
        <div>
          <dt>Backend</dt>
          <dd>Python · FastAPI · Pydantic · SQLAlchemy · Alembic · REST APIs · PostgreSQL · Redis</dd>
        </div>
        <div>
          <dt>Distributed systems</dt>
          <dd>Event-driven architecture · Asynchronous processing · Idempotency · Retries · Backpressure · Versioned contracts</dd>
        </div>
        <div>
          <dt>Infrastructure &amp; quality</dt>
          <dd>Docker · Linux · AWS · S3-compatible storage · Observability · Pytest · TDD · Contract testing</dd>
        </div>
      </dl>
    </section>

    <section class="credentials" aria-labelledby="credentials-heading">
      <h2 id="credentials-heading">Education &amp; Certifications</h2>
      <ul class="credentials-list">
        <li><strong>B.Sc. in Computer Science</strong>, Universidade Federal do Piauí (UFPI) · 2022 — Present</li>
        <li><strong>AWS Academy Graduate</strong> · Generative AI Foundations</li>
        <li><strong>AWS Academy Graduate</strong> · Cloud Foundations</li>
        <li><strong>EF SET English Certificate</strong> · B2 Upper Intermediate</li>
      </ul>
    </section>

    <section class="cta">
      <h2>Let's build AI that holds up</h2>
      <p>
        I'm open to AI Engineering and Software Engineering roles. If your team builds with LLMs, retrieval or machine learning, I'd like to hear about it.
      </p>
      <div class="cta-buttons">
        <a href="/contact" class="btn-primary">Get in Touch</a>
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
        )}
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 4rem 0 5rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 4rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .hero-left {
      padding-right: 2rem;
    }

    .eyebrow,
    .section-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
    }

    .hero-title {
      font-size: 2.25rem;
      line-height: 1.3;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
      color: var(--color-text);
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--color-text-secondary);
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .case-snapshot {
      display: block;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .case-snapshot:hover {
      border-color: var(--color-text-muted);
      background: var(--color-bg-elevated);
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .introduction {
      max-width: 600px;
      margin-bottom: 5rem;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .introduction h2,
    .focus h2,
    .principles h2,
    .experience h2,
    .skills h2,
    .credentials h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
    }

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-of-type {
      color: var(--color-text);
    }

    .focus,
    .principles,
    .experience,
    .skills,
    .credentials {
      margin-bottom: 5rem;
    }

    .focus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .focus-item {
      padding: 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }

    .focus-item h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .focus-item p {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
      margin: 0;
    }

    .principles-list,
    .skills-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 760px;
      margin: 0;
    }

    .principles-list dt,
    .skills-list dt {
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.25rem;
    }

    .principles-list dd,
    .skills-list dd {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    .experience-points {
      max-width: 760px;
      padding-left: 1.125rem;
      margin: 0 0 1rem;
      font-size: 0.9375rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    .experience-points li + li {
      margin-top: 0.375rem;
    }

    .credentials-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .credentials-list strong {
      color: var(--color-text);
      font-weight: 600;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .experience-item {
      padding: 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }

    .experience-item--primary {
      border-left: 3px solid var(--color-accent);
    }

    .experience-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    .experience-header h3 {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 0.375rem;
    }

    .experience-role,
    .experience-period,
    .experience-stack {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin: 0;
    }

    .experience-period {
      flex-shrink: 0;
      text-align: right;
    }

    .experience-stack {
      line-height: 1.6;
    }

    .cta {
      padding: 3rem 0;
      border-top: 1px solid var(--color-border);
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 500px;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.5rem 0 3rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-left {
        padding-right: 0;
      }

      .hero-title {
        font-size: 1.75rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        text-align: center;
        width: 100%;
      }

      .case-snapshot {
        padding: 1rem 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .experience-item,
      .focus-item {
        padding: 1.25rem;
      }

      .focus-grid {
        grid-template-columns: 1fr;
      }

      .experience-header {
        flex-direction: column;
        gap: 0.5rem;
      }

      .experience-period {
        text-align: left;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn-primary,
      .cta-buttons .btn-secondary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
